# Solaris — Solar Feasibility & Community Energy Planning Platform
# Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Default local instance: mongodb://127.0.0.1:27017/solaris_dheera
MONGODB_URI=mongodb://127.0.0.1:27017/solaris_dheera

# AI Assistant (Groq Cloud API)
# Model: openai/gpt-oss-20b
# If unset or invalid, the backend automatically uses the built-in deterministic offline rule advisory
GROQ_API_KEY=your_groq_api_key_here

# Application URL
APP_URL=http://localhost:3000
