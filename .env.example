# Express standalone port. Vite proxies /api to port 5000 during development.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/solaris_dheera

# Comma-separated browser origins with no trailing slash.
# Local development permits http://localhost:3000 and http://127.0.0.1:3000.
TRUSTED_ORIGINS=

# Optional, server-only. Leave empty to use rule-based advisory.
GROQ_API_KEY=
